# Скопируй в .env и раскомментируй нужное. Файл .env в git не попадает.

# Порт и адрес сервера (по умолчанию 8787 и только localhost)
# PORT=8787
# HOST=127.0.0.1

# Обязательно, если открываешь сервер в сеть (HOST=0.0.0.0): HTTP Basic Auth
# AI_HUB_USER=admin
# AI_HUB_PASSWORD=придумай-длинный-пароль

# Где хранить базу (провайдеры, ключи, агенты, чаты)
# AI_HUB_DB=./data/ai-hub.db

# Ключ Claude по умолчанию — если у провайдера Anthropic ключ не указан в интерфейсе
# ANTHROPIC_API_KEY=sk-ant-...

# Ключ GIPHY для ленты гифок (можно задать и в интерфейсе)
# GIPHY_API_KEY=
